<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Motor Controller Login</title>
  <style>
    body, html {
      margin: 0;
      padding: 0;
      height: 100%;
      font-family: sans-serif;
      background-color: #f4f4f4;
    }

    .login-section {
      background-image: url('login-bg.jpg'); /* background image */
      background-size: cover;
      background-position: center;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .box {
      max-width: 320px;
      width: 100%;
      padding: 20px;
      background: white;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0,0,0,0.2);
      text-align: center;
    }

    .hidden { display: none; }
    input, button {
      width: 100%;
      padding: 10px;
      margin: 8px 0;
      border: 1px solid #ccc;
      border-radius: 5px;
    }
    button {
      background: #007bff;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }
    button:hover { background: #0056b3; }
    .live-values {
      margin-top: 15px;
      text-align: left;
    }
    .live-values p {
      margin: 5px 0;
      font-weight: bold;
    }
  </style>
</head>
<body>

<!-- LOGIN PAGE -->
<div class="login-section" id="loginBox">
  <div class="box">
    <h2>Login</h2>
    <input type="text" id="username" placeholder="Username" required />
    <input type="password" id="password" placeholder="Password" required />
    <button onclick="login()">Login</button>
    <p id="error" style="color: red;"></p>
  </div>
</div>

<!-- CONTROL PAGE -->
<div class="login-section hidden" id="controlBox">
  <div class="box">
    <h2>Motor Controller</h2>
    <button onclick="motorOn()">🟢 Motor ON</button>
    <button onclick="motorOff()">🔴 Motor OFF</button>

    <div class="live-values">
      <h3>Live Values</h3>
      <p>V1: <span id="v1">--</span> V</p>
      <p>V2: <span id="v2">--</span> V</p>
      <p>V3: <span id="v3">--</span> V</p>
      <p>C1: <span id="c1">--</span> A</p>
      <p>C2: <span id="c2">--</span> A</p>
      <p>C3: <span id="c3">--</span> A</p>
    </div>
  </div>
</div>

<script>
  const correctUser = "ahir";
  const correctPass = "12345";

  function login() {
    const user = document.getElementById("username").value;
    const pass = document.getElementById("password").value;

    if (user === correctUser && pass === correctPass) {
      document.getElementById("loginBox").classList.add("hidden");
      document.getElementById("controlBox").classList.remove("hidden");
      startLiveValues();
    } else {
      document.getElementById("error").innerText = "Invalid Username or Password!";
    }
  }

  function motorOn() {
    alert("Motor ON command sent!");
  }

  function motorOff() {
    alert("Motor OFF command sent!");
  }

  // Fake live values (simulate)
  function startLiveValues() {
    setInterval(() => {
      document.getElementById("v1").innerText = (220 + Math.random()*10).toFixed(1);
      document.getElementById("v2").innerText = (220 + Math.random()*10).toFixed(1);
      document.getElementById("v3").innerText = (220 + Math.random()*10).toFixed(1);

      document.getElementById("c1").innerText = (10 + Math.random()*2).toFixed(2);
      document.getElementById("c2").innerText = (10 + Math.random()*2).toFixed(2);
      document.getElementById("c3").innerText = (10 + Math.random()*2).toFixed(2);
    }, 1000); // refresh every 1 sec
  }
</script>
</body>
</html>
